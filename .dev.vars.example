STRIPE_API_MODE=mock
STRIPE_SECRET_KEY=sk_test_mock_local_only
STRIPE_WEBHOOK_SECRET=whsec_local_test_secret_value
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
